# ===== 虚拟环境 =====
# 每个项目自己的 Python 和第三方库，体积大，且在任何机器上都能用
# `python -m venv .venv` 一条命令重建，所以绝不提交
.venv/
venv/
env/

# ===== Python 自动生成的缓存 =====
# 每次运行 .py 文件时自动生成，删掉也会自动重建
__pycache__/
*.py[cod]

# ===== 打包 / 构建产物 =====
build/
dist/
*.egg-info/

# ===== 编辑器与系统文件 =====
# 个人机器上的配置，别人不需要，也容易造成无意义的冲突
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== 敏感信息：绝对不要提交 =====
# 密码、token、API key 放这里，只在本机保留
.env
*.key
